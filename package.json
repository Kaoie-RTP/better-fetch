{
  "name": "@kaoie-rtp/better-fetch",
  "version": "1.1.1",
  "description": "Better Fetch is a lightweight, zero-dependency fetch wrapper for Browsers and Node.js",
  "keywords": [
    "fetch",
    "tiny",
    "lightweight"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rolldown",
    "test": "vitest",
    "release": "pnpm run build && pnpm run test && pnpm publish"
  },
  "license": "MIT",
  "author": "Ratipat Ongniam <kaoratipatra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaoie-RTP/better-fetch.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "rolldown": "^1.2.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "rolldown-plugin-dts": "^0.28.6"
  }
}